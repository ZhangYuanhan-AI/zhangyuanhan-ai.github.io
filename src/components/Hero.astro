---
const shipped = [
  {
    name: 'Muse',
    tag: 'Product',
    tagClass: 'text-[#8BA89A] bg-[#8BA89A]/10',
    url: 'https://muse.ai/',
    linkLabel: 'muse.ai',
    description: "Meta's new AI product.",
  },
  {
    name: 'Muse Spark 1.3',
    tag: 'Model',
    tagClass: 'text-[#C2A67E] bg-[#C2A67E]/10',
    url: 'https://research.meta.ai/blog/introducing-muse-spark-1-3',
    linkLabel: 'Blog',
    description: "The latest version of Meta's Muse Spark model.",
  },
];
---

<section class="relative overflow-hidden pt-16 pb-10 md:pt-24 md:pb-14">
  <div class="max-w-3xl mx-auto px-6">
    <div class="flex flex-col-reverse md:flex-row items-center gap-8 md:gap-14">
      <div class="flex-1 text-center md:text-left">
        <h1>
          <span class="block text-4xl sm:text-5xl md:text-6xl font-black tracking-tighter text-[#3D3835] dark:text-[#C4BCB4] leading-[0.9]">YUANHAN <span class="text-lg sm:text-xl md:text-2xl font-semibold text-[#9B948E] dark:text-[#6B6460] tracking-normal">(John)</span></span>
          <span class="block text-4xl sm:text-5xl md:text-6xl font-black tracking-tighter leading-[0.9] gradient-text">ZHANG</span>
        </h1>

        <a href="https://translate.google.com/?hl=zh-CN&sl=auto&tl=zh-CN&text=%E5%85%83%E7%80%9A&op=translate" target="_blank" rel="noopener noreferrer"
          aria-label="Listen to Chinese pronunciation"
          class="inline-flex items-center gap-1.5 mt-2 hover:opacity-80 transition-opacity text-[#9B948E] dark:text-[#6B6460]">
          <span class="text-base"><span class="gradient-text font-bold">张</span> <span class="text-[#3D3835] dark:text-[#C4BCB4]">元瀚</span></span>
        </a>

        <p class="mt-5 text-[15px] text-[#6B6460] dark:text-[#A39D97] sm:whitespace-nowrap leading-normal">
          Coder at <a href="https://about.meta.com/" target="_blank" rel="noopener noreferrer" class="text-[#3D3835] dark:text-[#C4BCB4] hover:text-[#8BA89A] dark:hover:text-[#A3BDAE] transition-colors">Meta Superintelligence Lab</a>.
        </p>
        <p class="mt-2 text-[15px] text-[#6B6460] dark:text-[#A39D97] sm:whitespace-nowrap leading-normal">
          PhD from <a href="https://www.mmlab-ntu.com/" target="_blank" rel="noopener noreferrer" class="text-[#3D3835] dark:text-[#C4BCB4] hover:text-[#8BA89A] dark:hover:text-[#A3BDAE] transition-colors">MMLab@NTU</a>, advised by Prof. <a href="https://liuziwei7.github.io/" target="_blank" rel="noopener noreferrer" class="text-[#3D3835] dark:text-[#C4BCB4] hover:text-[#8BA89A] dark:hover:text-[#A3BDAE] transition-colors">Ziwei Liu</a>.
        </p>
        <p class="mt-2 text-[15px] text-[#6B6460] dark:text-[#A39D97] max-w-sm leading-relaxed">
          I'm fortunate to work with talented people on frontier large language models, where I focus on
          <span class="text-[#3D3835] dark:text-[#C4BCB4]">post-training</span>.
          Recently, I contributed to
          <a href="https://research.meta.ai/blog/introducing-muse-spark-1-3" target="_blank" rel="noopener noreferrer" class="text-[#3D3835] dark:text-[#C4BCB4] hover:text-[#8BA89A] dark:hover:text-[#A3BDAE] transition-colors">Muse Spark 1.3</a> and
          <a href="https://muse.ai/" target="_blank" rel="noopener noreferrer" class="text-[#3D3835] dark:text-[#C4BCB4] hover:text-[#8BA89A] dark:hover:text-[#A3BDAE] transition-colors">Muse</a>.
        </p>

        <div class="mt-5 flex flex-wrap justify-center md:justify-start gap-4">
          <a href="mailto:yuanhan002@e.ntu.edu.sg" class="font-mono text-xs text-[#9B948E] dark:text-[#7A746E] hover:text-[#8BA89A] dark:hover:text-[#A3BDAE] transition-colors">Email</a>
          <a href="https://scholar.google.com/citations?user=g6grFy0AAAAJ&hl" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-[#9B948E] dark:text-[#7A746E] hover:text-[#8BA89A] dark:hover:text-[#A3BDAE] transition-colors">Scholar</a>
          <a href="https://twitter.com/zhang_yuanhan" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-[#9B948E] dark:text-[#7A746E] hover:text-[#8BA89A] dark:hover:text-[#A3BDAE] transition-colors">Twitter</a>
          <a href="https://github.com/ZhangYuanhan-AI" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-[#9B948E] dark:text-[#7A746E] hover:text-[#8BA89A] dark:hover:text-[#A3BDAE] transition-colors">GitHub</a>
          <a href="https://www.linkedin.com/in/yuanhan-zhang-b09a95b5/" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-[#9B948E] dark:text-[#7A746E] hover:text-[#8BA89A] dark:hover:text-[#A3BDAE] transition-colors">LinkedIn</a>
        </div>

      </div>

      <div class="flex-shrink-0 relative group">
        <div class="absolute -inset-6 rounded-full bg-[#8BA89A]/[0.04] blur-2xl group-hover:bg-[#8BA89A]/[0.07] transition-all duration-700"></div>
        <a href="/images/zyh_5.png" target="_blank" rel="noopener noreferrer" class="relative block">
          <img src="/images/zyh_5_circle.jpg" alt="Yuanhan Zhang" loading="eager"
            class="relative w-44 h-44 md:w-56 md:h-56 rounded-full object-cover ring-1 ring-[#DDD6CC] dark:ring-[#2E2C28] group-hover:ring-[#8BA89A]/40 dark:group-hover:ring-[#A3BDAE]/30 transition-all duration-700" />
        </a>
      </div>
    </div>

    <!-- Shipped — products and models I contributed to -->
    <div class="mt-10 pt-8 border-t border-[#DDD6CC]/40 dark:border-[#2E2C28]/60">
      <p class="section-heading !mb-3">Shipped</p>
      <div class="space-y-4">
        {shipped.map(item => (
          <div class="flex items-start gap-3.5">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2.5 flex-wrap">
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-base font-bold text-[#3D3835] dark:text-[#C4BCB4] hover:text-[#8BA89A] dark:hover:text-[#A3BDAE] transition-colors leading-snug">{item.name}</a>
                <span class={`pill ${item.tagClass}`}>{item.tag}</span>
              </div>
              <p class="mt-0.5 text-[15px] text-[#6B6460] dark:text-[#A39D97] leading-relaxed">{item.description}</p>
            </div>
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="link-btn shrink-0">{item.linkLabel}</a>
          </div>
        ))}
      </div>
    </div>

    <!-- Current Interests — between hero and Featured Work -->
    <div class="mt-10 pt-8 border-t border-[#DDD6CC]/40 dark:border-[#2E2C28]/60">
      <p class="section-heading !mb-3">Current Interests</p>
      <div class="space-y-2 text-[15px] leading-relaxed">
        <p class="text-[#6B6460] dark:text-[#A39D97]">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#8BA89A] dark:bg-[#A3BDAE] mr-1.5 relative top-[-1px]"></span>
          <span class="text-[#3D3835] dark:text-[#C4BCB4] font-medium">Agentic LLM Ability:</span>
          Training models that plan over long horizons, use tools reliably, and learn from environment feedback to correct their own mistakes.
        </p>
        <p class="text-[#6B6460] dark:text-[#A39D97]">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#8BA89A] dark:bg-[#A3BDAE] mr-1.5 relative top-[-1px]"></span>
          <span class="text-[#3D3835] dark:text-[#C4BCB4] font-medium">Information-dense Video Reasoning:</span>
          Building models that identify salient details, connect dispersed evidence, and infer causal structure in complex visual narratives.
        </p>
        <p class="text-[#6B6460] dark:text-[#A39D97]">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#8BA89A] dark:bg-[#A3BDAE] mr-1.5 relative top-[-1px]"></span>
          <span class="text-[#3D3835] dark:text-[#C4BCB4] font-medium">Benchmarking Model–Human Gaps:</span>
          Developing diagnostic benchmarks that reveal systematic differences between models and humans, and suggest better optimization targets.
        </p>
      </div>
    </div>


  </div>
</section>
